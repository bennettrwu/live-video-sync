{
  "name": "@live-video-sync/fastify-platform",
  "version": "0.0.0",
  "description": "Fastify boilerplate: logger, request ids, validation, error handling, DI, websocket routes with message validation",
  "author": "bennettrwu",
  "license": "MIT",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "type": "module",
  "imports": {
    "#src/*": {
      "development": "./src/*",
      "default": "./dist/src/*"
    },
    "#tests/*": {
      "development": "./tests/*",
      "default": "./dist/tests/*"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "format": "prettier --check ./src ./tests",
    "format:fix": "prettier --write ./src ./tests",
    "lint": "eslint ./src ./tests",
    "lint:fix": "eslint ./src ./tests --fix",
    "test:dev": "vitest --ui --coverage",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@fastify/awilix": "8.2.0",
    "@fastify/sensible": "6.0.4",
    "@fastify/type-provider-typebox": "6.1.0",
    "@fastify/websocket": "11.2.0",
    "awilix": "13.0.0",
    "fastify": "5.12.5",
    "fastify-plugin": "5.1.0",
    "pino": "10.3.1",
    "typebox": "1.1.5",
    "uuid": "13.0.0"
  }
}
