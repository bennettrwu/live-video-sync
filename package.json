{
  "name": "live-video-sync",
  "version": "0.0.0",
  "description": "Watch HLS video in sync across browsers",
  "author": "bennettrwu",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build",
    "format": "npm run format --workspaces --if-present",
    "format:fix": "npm run format:fix --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "dev": "concurrently -k -n server,web \"npm run dev --workspace apps/sync-server\" \"npm run dev --workspace apps/frontend\"",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace e2e"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "26.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vitest/ui": "4.1.10",
    "concurrently": "10.0.3",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.1",
    "globals": "17.3.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  }
}
