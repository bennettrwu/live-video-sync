{
  "name": "@live-video-sync/frontend",
  "version": "0.0.0",
  "description": "Synced video player web app",
  "author": "bennettrwu",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": {
      "development": "./src/*",
      "default": "./dist/src/*"
    },
    "#tests/*": {
      "development": "./tests/*",
      "default": "./dist/tests/*"
    }
  },
  "scripts": {
    "build": "tsc --build && vite build",
    "preview": "vite preview",
    "dev": "vite",
    "format": "prettier --check ./src ./tests",
    "format:fix": "prettier --write ./src ./tests",
    "lint": "eslint ./src ./tests",
    "lint:fix": "eslint ./src ./tests --fix",
    "test:dev": "vitest --ui --coverage",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@live-video-sync/sync-engine": "*",
    "@live-video-sync/sync-protocol": "*",
    "@mantine/core": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "@tabler/icons-react": "3.49.0",
    "hls.js": "1.7.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.18.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "jsdom": "29.1.1",
    "postcss": "8.5.29",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1"
  }
}
